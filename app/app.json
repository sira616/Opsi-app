{
  "expo": {
    "name": "Opsi",
    "slug": "opsi",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "opsi",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.opsi.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.opsi.app",
      "edgeToEdgeEnabled": true,
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-router"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "backgroundColor": "#F6F5F2",
      "resizeMode": "contain"
    }
  }
}
