# ─────────────────────────────────────────────────────────────────────────────
# Cliente (app Expo). Copiar a .env y rellenar.
#
# Todo lo que empieza por EXPO_PUBLIC_ SE INCRUSTA EN EL BINARIO y es visible
# para cualquiera que descargue la app. Aquí solo va lo que es público por
# diseño. Las claves de verdad (service_role, Anthropic) NO viven aquí:
# van como secrets del servidor, ver supabase/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase local (los valores exactos los imprime `npm run db:status`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# En un dispositivo físico, 127.0.0.1 es el propio móvil: hay que poner la IP
# de tu ordenador en la red local, por ejemplo
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.42:54321
